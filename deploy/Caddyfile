# HTTPS für den Vokabeltrainer. Domain anpassen; sie muss per DNS auf diesen Server zeigen,
# Ports 80 und 443 müssen erreichbar sein. Im Vokabeltrainer TRUST_PROXY=true setzen.

vokabeltrainer.example.org {
	encode zstd gzip
	# Im Docker-Compose-Netz heißt der Dienst "vokabeltrainer"; bei direkter Installation localhost:3000.
	reverse_proxy vokabeltrainer:3000
}
