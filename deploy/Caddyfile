# HTTPS für Gero. Domain anpassen; sie muss per DNS auf diesen Server zeigen,
# Ports 80 und 443 müssen erreichbar sein. In Gero TRUST_PROXY=true setzen.

gero.example.org {
	encode zstd gzip
	# Im Docker-Compose-Netz heißt der Dienst "gero"; bei direkter Installation localhost:3000.
	reverse_proxy gero:3000
}
