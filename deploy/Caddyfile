# HTTPS für WordFlow. Domain anpassen; sie muss per DNS auf diesen Server zeigen,
# Ports 80 und 443 müssen erreichbar sein. In WordFlow TRUST_PROXY=true setzen.

wordflow.example.org {
	encode zstd gzip
	# Im Docker-Compose-Netz heißt der Dienst "wordflow"; bei direkter Installation localhost:3000.
	reverse_proxy wordflow:3000
}
