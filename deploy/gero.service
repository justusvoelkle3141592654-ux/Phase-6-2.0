# systemd-Dienst für Gero (direkte Node.js-Installation).
# Installation:
#   sudo useradd --system --home /opt/gero --shell /usr/sbin/nologin gero
#   sudo cp deploy/gero.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now gero
# Logs (auch der Registrierungscode beim ersten Start): journalctl -u gero

[Unit]
Description=Gero Vokabeltrainer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gero
Group=gero
WorkingDirectory=/opt/gero
Environment=NODE_ENV=production
# Einstellungen aus /opt/gero/.env werden vom Server selbst gelesen.
ExecStart=/usr/bin/node apps/server/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gero/data

[Install]
WantedBy=multi-user.target
