# systemd-Dienst für WordFlow (direkte Node.js-Installation).
# Installation:
#   sudo useradd --system --home /opt/wordflow --shell /usr/sbin/nologin wordflow
#   sudo cp deploy/wordflow.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now wordflow
# Logs (auch der Registrierungscode beim ersten Start): journalctl -u wordflow

[Unit]
Description=WordFlow Vokabeltrainer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wordflow
Group=wordflow
WorkingDirectory=/opt/wordflow
Environment=NODE_ENV=production
# Einstellungen aus /opt/wordflow/.env werden vom Server selbst gelesen.
ExecStart=/usr/bin/node apps/server/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wordflow/data

[Install]
WantedBy=multi-user.target
