{
  "name": "wordflow",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @wordflow/server\" \"npm run dev -w @wordflow/web\"",
    "build": "npm run build -w @wordflow/web && npm run build -w @wordflow/server",
    "start": "npm run start -w @wordflow/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "android:sync": "npm run android:sync -w @wordflow/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
