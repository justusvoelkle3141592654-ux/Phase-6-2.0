<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed so the app can reach a Vokabeltrainer server in the home network
     (e.g. http://192.168.1.20:3000). Servers on the internet should use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
