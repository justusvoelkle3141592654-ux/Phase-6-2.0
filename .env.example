# Kopiere diese Datei nach .env und passe die Werte an.

# Port und Adresse des Servers
PORT=3000
HOST=0.0.0.0

# Ordner für Datenbank, Fotos und erzeugte Schlüssel (relativ zum Projektordner)
DATA_DIR=data

# Auf "true" setzen, wenn ein Reverse-Proxy (Caddy, nginx) davor HTTPS übernimmt
TRUST_PROXY=false

# Zusätzliche erlaubte Herkünfte (Origins), kommagetrennt. Die Android-App ist schon erlaubt.
CORS_ORIGINS=

# Log-Level: fatal, error, warn, info, debug, trace oder silent
LOG_LEVEL=info

# Code, den man bei der Registrierung eingeben muss. Leer lassen: Der Server erzeugt beim
# ersten Start einen Code, speichert ihn in DATA_DIR/secrets.json und schreibt ihn ins Log.
REGISTRATION_CODE=

# Hauptschlüssel für die Verschlüsselung gespeicherter API-Schlüssel. Leer lassen: wird
# beim ersten Start erzeugt und in DATA_DIR/secrets.json gespeichert. Nicht verlieren!
APP_SECRET=
